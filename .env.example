# ============================================================
# WhatsApp Reminder Platform - environment configuration
# Copy this file to .env and fill in real values.
# ============================================================

# --- Server ---
PORT=8080
# Used to build the Google OAuth redirect URI and links in emails/pages; set
# this to the URL you actually reach the app at (e.g. https://reminders.example.com).
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated list of admin API keys allowed to manage users, Settings
# (storage backend selection), and the Postgres/Google integration setup.
ADMIN_API_KEYS=change-me-admin-key

# --- Storage backend(s) ---
# Bootstrap-only default(s) for the very first boot. Comma-separated, any
# combination of "postgres", "sheets", "ha_local". After first boot, this is
# controlled from the Settings web page (/settings.html) instead - it's
# persisted to DATA_DIR/settings.json and can be changed without a restart.
# "ha_local" needs no further config; add postgres/sheets from Settings
# (Postgres: Auto or Manual; Sheets: "Connect with Google").
STORAGE_BACKENDS=ha_local

# Where settings.json and the ha_local JSON store live. Mount this as a
# volume (see docker-compose.yml) so it survives container recreates.
DATA_DIR=./data

# --- PostgreSQL ---
# Preferred: leave DATABASE_URL blank and set these up from Settings ->
# Postgres instead, which has separate host/port/database/user/password
# fields (Manual) or a one-click container creation flow (Auto) rather than
# hand-building a connection string.
#
# POSTGRES_MODE=auto tells the app to try creating a Postgres container for
# itself at boot, using the POSTGRES_AUTO_* fields below as the initial
# details (blank password -> one is generated for you). Needs a reachable
# Docker socket - see the commented-out docker.sock mount in
# docker-compose.yml. POSTGRES_MODE=manual (the default) never does this on
# its own.
POSTGRES_MODE=manual
POSTGRES_AUTO_DATABASE=reminders
POSTGRES_AUTO_USER=reminder_user
POSTGRES_AUTO_PASSWORD=
POSTGRES_AUTO_PORT=5433
#
# Manual, set directly (bypasses Settings' Manual fields, useful for a
# fully scripted first boot): leave blank to configure via Settings instead.
DATABASE_URL=
PGSSL=false

# --- Google Sheets ---
# There's nothing to set here. Google Sheets connects only through "Connect
# with Google" in Settings (OAuth) - no service account JSON, no spreadsheet
# ID to configure by hand. Which spreadsheet to use is picked from Settings
# after connecting. The Google OAuth client below is what powers that button.

# --- Google OAuth client, powers the "Connect with Google" button ---
# Create once in Google Cloud Console -> APIs & Services -> Credentials ->
# "OAuth client ID" -> Web application, with
# {PUBLIC_BASE_URL}/api/integrations/google/callback added under
# "Authorized redirect URIs". End users of this platform never see that
# console - they just click Connect.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- WAHA (WhatsApp HTTP API) gateway ---
WAHA_BASE_URL=https://3store.tech
WAHA_API_KEY=change-me-waha-key

# --- ha-whatsapp (https://faserf.github.io/ha-whatsapp/) gateway ---
# Home Assistant instance running the ha-whatsapp custom integration.
# Used only when a user's number is configured with gateway=ha-whatsapp.
HA_BASE_URL=https://3store.tech
HA_LONG_LIVED_TOKEN=change-me-ha-token
# ha-whatsapp exposes its send action as a HA service call, e.g. whatsapp.send_message
HA_WHATSAPP_SERVICE=whatsapp.send_message

# --- Home Assistant webhook notifications (optional, fired after every send) ---
HA_NOTIFY_WEBHOOK_URL=https://3store.tech/api/webhook/reminder_sent

# --- Scheduler ---
# Cron expression for how often to scan for due reminders
SCHEDULER_CRON=*/1 * * * *
# Typing indicator delay before sending (ms), matches original Apps Script behavior
TYPING_DELAY_MS=10000

# --- Footer template default (Handlebars-style {{placeholders}}) ---
DEFAULT_FOOTER_TEMPLATE="\n\n~Auto Reminder~      ~تذكير تلقائي~"
